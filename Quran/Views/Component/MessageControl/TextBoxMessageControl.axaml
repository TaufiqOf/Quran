<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quran.Views.Component.MessageControl.TextBoxMessageControl"
    x:Name="Root">

    <UserControl.Styles>
        <!-- Removes the focus rectangle ring/adorner -->
        <!-- Removes focus ring from message text boxes inside expanders -->
        <Style Selector="TextBox.messageBox">
            <Setter Property="Background" Value="Transparent" /> 
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /> 
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Keep transparent on hover -->

        <Style Selector="TextBox.messageBox:pointerover">
            <Setter Property="Background" Value="Transparent" /> 
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Override template border on hover -->

        <Style Selector="TextBox.messageBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" /> 
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Keep transparent when focused -->

        <Style Selector="TextBox.messageBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Keep transparent when focused and hovered -->

        <Style Selector="TextBox.messageBox:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <TextBox x:Name="TextBoxMessage"
             Classes="messageBox"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             Background="Transparent"
             BorderThickness="0"
             Focusable="True"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

</UserControl>