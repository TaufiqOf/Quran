<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Quran.Views.Component.MessageControl.VerseMessageControl"
    x:Name="Root">

    <UserControl.Styles>
        <!-- Removes the focus rectangle ring/adorner -->
        <Style Selector="TextBox#TextBoxMessage">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Overrides styles applied when the TextBox gets focus -->
        <Style Selector="TextBox#TextBoxMessage:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Ensures pointerover (hover) during focus also stays transparent -->
        <Style Selector="TextBox#TextBoxMessage:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.metaText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.verseText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock
                x:Name="TextBlockSurahMeta"
                Classes="metaText"
                Text="(1) Al-Fatihah - \u0627\u0644\u0641\u0627\u062a\u062d\u0629" />
            <TextBlock
                x:Name="TextBlockVerseNumber"
                Grid.Column="1"
                Classes="verseText"
                Text="Verse 1"
                Margin="12,0,0,0" />
        </Grid>

        <TextBox
            x:Name="TextBoxMessage"
            Grid.Row="1"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Background="Transparent"
            BorderThickness="0"
            Focusable="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </Grid>

</UserControl>