<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="clr-namespace:Quran.Views.Component.MessageControl"
    x:Class="Quran.Views.Component.MessageControl.VerseMessageControl"
    x:Name="Root">

    <UserControl.Styles>
        <!-- Removes focus ring from message text boxes inside expanders -->
        <Style Selector="TextBox.messageBox">
            <Setter Property="Background" Value="Transparent" /> 
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /> 
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <!-- Keep transparent on hover -->

        <Style Selector="TextBox.messageBox:pointerover">
            <Setter Property="Background" Value="Transparent" /> 
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Override template border on hover -->

        <Style Selector="TextBox.messageBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" /> 
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Keep transparent when focused -->

        <Style Selector="TextBox.messageBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Keep transparent when focused and hovered -->

        <Style Selector="TextBox.messageBox:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        
 

        <Style Selector="Expander.verseMessageExpander">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TextBlock.metaText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.verseText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="MessagesItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="mc:VerseMessageModel">
                    <Expander
                        Classes="verseMessageExpander"
                        HorizontalAlignment="Stretch"
                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                        Expanded="Expander_OnExpanded">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="metaText">
                                    <Run Text="(" />
                                    <Run Text="{Binding Surah.Id}" />
                                    <Run Text=") " />
                                    <Run Text="{Binding Surah.Transliteration}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding Surah.Name}" />
                                </TextBlock>
                                <TextBlock
                                    Grid.Column="1"
                                    Classes="verseText"
                                    Text="{Binding Verse.Id, StringFormat=Verse {0}}"
                                    Margin="12,0,0,0" />
                            </Grid>
                        </Expander.Header>

                        <TextBox
                            Classes="messageBox"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Text="{Binding Message}"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="True"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</UserControl>