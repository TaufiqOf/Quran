<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quran.Views.Component.VerseComponent"
             x:Name="Root"
             Margin="5">

    <UserControl.Styles>

        <!-- ========================================= -->
        <!-- Normal Card -->
        <!-- ========================================= -->

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10" />
        </Style>


        <!-- ========================================= -->
        <!-- Selected Card -->
        <!-- ========================================= -->

        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="#3678D4" />
        </Style>


        <!-- ========================================= -->
        <!-- Verse Number -->
        <!-- ========================================= -->

        <Style Selector="TextBlock.verseNumber">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8F8F8F" />
        </Style>

        <Style Selector="Border.card.selected TextBlock.verseNumber">
            <Setter Property="Foreground" Value="#3678D4" />
        </Style>


        <!-- ========================================= -->
        <!-- Arabic -->
        <!-- ========================================= -->

        <Style Selector="SelectableTextBlock.arabic">
            <Setter
                Property="FontFamily"
                Value="avares://Quran/Assets/Fonts/Amiri-Regular.ttf#Amiri" />

            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>


        <!-- ========================================= -->
        <!-- Transliteration -->
        <!-- ========================================= -->

        <Style Selector="SelectableTextBlock.transliteration">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="#BDBDBD" />
            <Setter Property="LineHeight" Value="24" />
        </Style>


        <!-- ========================================= -->
        <!-- Translation -->
        <!-- ========================================= -->

        <Style Selector="SelectableTextBlock.translation">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#D8D8D8" />
            <Setter Property="LineHeight" Value="26" />
        </Style>

        <Style Selector="Border.card.selected Button.iconButton">
            <Setter Property="Background" Value="#404040" />
        </Style>
    </UserControl.Styles>


    <!-- ============================================= -->
    <!-- Main Card -->
    <!-- ============================================= -->

    <Border
        x:Name="VerseCard"
        Classes="card"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        PointerPressed="VerseCard_OnPointerPressed">

        <Grid x:Name="VerseGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================================== -->
            <!-- Arabic Verse -->
            <!-- ===================================== -->

            <SelectableTextBlock
                x:Name="TextBlockArabic"
                Grid.Row="0"
                Classes="arabic"
                TextWrapping="Wrap"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,18" />


            <!-- ===================================== -->
            <!-- Transliteration -->
            <!-- ===================================== -->

            <SelectableTextBlock
                x:Name="TextBlockTransliteration"
                Grid.Row="2"
                Classes="transliteration"
                TextWrapping="Wrap"
                HorizontalAlignment="Right"
                Margin="0,0,0,12" />


            <!-- ===================================== -->
            <!-- Translation -->
            <!-- ===================================== -->

            <SelectableTextBlock
                x:Name="TextBlockTranslation"
                Grid.Row="3"
                Classes="translation"
                TextWrapping="Wrap"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,18" />


            <!-- ===================================== -->
            <!-- Buttons -->
            <!-- ===================================== -->

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <TextBlock
                    x:Name="TextBlockBookmark"
                    Text="&#xF02E; "
                    FontFamily="avares://Quran/Assets/Fonts#Font Awesome 7 Free"
                    FontWeight="Black"
                    Margin="0,1,0,0"
                    FontSize="16" />
                <TextBlock
                    x:Name="TextBlockVerseNumber"
                    Classes="verseNumber"
                    Text="Verse 1"
                    HorizontalAlignment="Right"
                    Margin="5,0,0,0" />

            </StackPanel>


        </Grid>

    </Border>

</UserControl>