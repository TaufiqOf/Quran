<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="Quran.Views.Component.VerseComponent"
             x:Name="Root"
             Margin="10">

    <UserControl.Styles>

        <!-- ========================================= -->
        <!-- Normal Card -->
        <!-- ========================================= -->

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>


        <!-- ========================================= -->
        <!-- Selected Card -->
        <!-- ========================================= -->

        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>


        <!-- ========================================= -->
        <!-- Verse Number -->
        <!-- ========================================= -->

        <Style Selector="TextBlock.verseNumber">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8F8F8F"/>
        </Style>

        <Style Selector="Border.card.selected TextBlock.verseNumber">
            <Setter Property="Foreground" Value="Yellow"/>
        </Style>


        <!-- ========================================= -->
        <!-- Arabic -->
        <!-- ========================================= -->

        <Style Selector="TextBlock.arabic">
            <Setter
                Property="FontFamily"
                Value="avares://Quran/Assets/Fonts/AmiriQuran-Regular.ttf#Amiri Quran"/>

            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
        </Style>


        <!-- ========================================= -->
        <!-- Transliteration -->
        <!-- ========================================= -->

        <Style Selector="TextBlock.transliteration">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#BDBDBD"/>
            <Setter Property="LineHeight" Value="24"/>
        </Style>


        <!-- ========================================= -->
        <!-- Translation -->
        <!-- ========================================= -->

        <Style Selector="TextBlock.translation">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="LineHeight" Value="26"/>
        </Style>


        <!-- ========================================= -->
        <!-- Icon Buttons -->
        <!-- ========================================= -->

        <Style Selector="Button.iconButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
        </Style>

        <Style Selector="Button.iconButton:pointerover">
            <Setter Property="Background" Value="#444444"/>
        </Style>

        <Style Selector="Button.iconButton:pressed">
            <Setter Property="Background" Value="#505050"/>
        </Style>


        <!-- ========================================= -->
        <!-- Selected Play/Bookmark Buttons -->
        <!-- ========================================= -->
        <Style Selector="Border.card.selected Button.iconButton">
            <Setter Property="Background" Value="#404040"/>
        </Style>
    </UserControl.Styles>


    <!-- ============================================= -->
    <!-- Main Card -->
    <!-- ============================================= -->

    <Border
        x:Name="VerseCard"
        Classes="card"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        PointerPressed="VerseCard_OnPointerPressed">

        <Grid x:Name="VerseGrid">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ===================================== -->
            <!-- Verse Number -->
            <!-- ===================================== -->

            <TextBlock
                x:Name="TextBlockVerseNumber"
                Grid.Row="0"
                Classes="verseNumber"
                Text="Verse 1"
                HorizontalAlignment="Left"
                Margin="0,-15,0,16"/>


            <!-- ===================================== -->
            <!-- Arabic Verse -->
            <!-- ===================================== -->

            <TextBlock
                x:Name="TextBlockArabic"
                Grid.Row="0"
                Classes="arabic"
                TextWrapping="Wrap"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,18"/>


            <!-- ===================================== -->
            <!-- Transliteration -->
            <!-- ===================================== -->

            <TextBlock
                x:Name="TextBlockTransliteration"
                Grid.Row="2"
                Classes="transliteration"
                TextWrapping="Wrap"
                HorizontalAlignment="Right"
                Margin="0,0,0,12"/>


            <!-- ===================================== -->
            <!-- Translation -->
            <!-- ===================================== -->

            <TextBlock
                x:Name="TextBlockTranslation"
                Grid.Row="3"
                Classes="translation"
                TextWrapping="Wrap"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,18"/>


            <!-- ===================================== -->
            <!-- Buttons -->
            <!-- ===================================== -->

            <StackPanel
                x:Name="ButtonPanel"
                Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">

                <Button
                    x:Name="ButtonPlay"
                    Classes="iconButton"
                    ToolTip.Tip="Play verse"
                    Click="ButtonPlay_OnClick">

                    <icons:SymbolIcon
                        x:Name="IconPlay"
                        Symbol="Play"
                        FontSize="20"/>

                </Button>


                <Button
                    x:Name="ButtonBookmark"
                    Classes="iconButton"
                    ToolTip.Tip="Bookmark verse"
                    Click="ButtonBookmark_OnClick">

                    <icons:SymbolIcon
                        x:Name="IconBookmark"
                        Symbol="Bookmark"
                        FontSize="20"/>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>