<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quran.Views.Pages.AboutView">

    <UserControl.Styles>
        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F2F2F2" />
        </Style>

        <Style Selector="TextBlock.sectionSubtitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#BEBEBE" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <Style Selector="ComboBox.settingsInput">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

    </UserControl.Styles>
    <ScrollViewer>
        <Grid Margin="20"
              RowDefinitions="*,Auto,*"
              ColumnDefinitions="*">
            <Border Grid.Row="1"
                    Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel>
                        <Image Source="avares://Quran/Assets/Icons/Quran-icons/Quran-256x256.png" Width="256" Height="256" />
                        <TextBlock Classes="sectionTitle"
                                   Text="About" />
                    </StackPanel>
                    <TextBlock Classes="sectionSubtitle"
                               Text="Personalize your reading experience." />

                    <Separator Margin="0,2,0,4" />

                    <TextBlock Classes="fieldLabel"
                               Text="Quran Translation Language" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>