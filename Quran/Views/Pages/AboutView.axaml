<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Quran.Models"
             x:Class="Quran.Views.Pages.AboutView">

    <UserControl.Styles>
        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F2F2F2" />
        </Style>

        <Style Selector="TextBlock.sectionSubtitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#BEBEBE" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <Style Selector="ComboBox.settingsInput">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">

            <!-- Header Section -->
            <Border Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="avares://Quran/Assets/Icons/Quran-icons/Quran-256x256.png"
                               Width="128" Height="128"
                               HorizontalAlignment="Center" />
                        <TextBlock Classes="sectionTitle"
                                   Text="About Quran"
                                   TextAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="sectionSubtitle"
                               Text="A modern, open-source Quran reader with advanced search and AI-powered features."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Classes="sectionSubtitle"
                               x:Name="VersionTextBlock"
                               Text="Version"
                               TextAlignment="Center"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Translators Section -->
            <Border Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Classes="fieldLabel"
                               Text="Credits" />
                    <Separator Margin="0,2,0,4" />

                    <ItemsControl x:Name="TranslatorsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AboutCreditItem">
                                <Border Background="#2A2A2A"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,4">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#E8E8E8"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#BEBEBE"
                                            Text="{Binding Value}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Search Guide Section -->
            <Border Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Classes="fieldLabel"
                               Text="💡 Search Tips" />
                    <Separator Margin="0,2,0,4" />
                    <ItemsControl x:Name="SearchTipsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AboutTextItem">
                                <TextBlock FontSize="12"
                                           Foreground="#BEBEBE"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="{Binding Text}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- AI Answer Section -->
            <Border Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Classes="fieldLabel"
                               Text="🤖 Ask AI" />
                    <Separator Margin="0,2,0,4" />
                    <ItemsControl x:Name="AiAnswerItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AboutTextItem">
                                <TextBlock FontSize="12"
                                           Foreground="#BEBEBE"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="{Binding Text}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Packages Section -->
            <Border Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Classes="fieldLabel"
                               Text="Open Source Libraries" />
                    <Separator Margin="0,2,0,4" />

                    <ItemsControl x:Name="PackagesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AboutPackageItem">
                                <Border Background="#2A2A2A"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,4">
                                    <TextBlock FontSize="12"
                                               Foreground="#BEBEBE"
                                               Text="{Binding DisplayText}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Disclaimer Section -->
            <Border Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Classes="fieldLabel"
                               Text="Disclaimer" />
                    <Separator Margin="0,2,0,4" />

                    <StackPanel Spacing="8">
                        <ItemsControl x:Name="DisclaimerItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AboutTextItem">
                                    <TextBlock FontSize="12"
                                               Foreground="#BEBEBE"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Text="{Binding Text}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="LicenseTextBlock"
                                   FontSize="12"
                                   Foreground="#9A9A9A"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>