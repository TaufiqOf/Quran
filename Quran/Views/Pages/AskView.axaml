<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:pages="clr-namespace:Quran.Views.Pages"
    x:Class="Quran.Views.Pages.AskView">

    <UserControl.Styles>

        <!-- Copy & Action Buttons -->
        <Style Selector="Button.copyButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.copyButton:pointerover">
            <Setter Property="Background" Value="#333333" />
        </Style>

        <Style Selector="Button.copyButton:pressed">
            <Setter Property="Background" Value="#444444" />
        </Style>

        <Style Selector="Button.searchButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.searchButton:pointerover">
            <Setter Property="Background" Value="#333333" />
        </Style>

        <Style Selector="Button.searchButton:pressed">
            <Setter Property="Background" Value="#444444" />
        </Style>

        <Style Selector="TextBlock.messageTextBlock">
            <Setter Property="Foreground" Value="LightCoral" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Search Container -->
        <Style Selector="Border.searchBox">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <!-- Search TextBox -->
        <Style Selector="TextBox.searchTextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontFamily" Value="avares://Quran/Assets/Fonts/Amiri-Regular.ttf#Amiri" />
            <Setter Property="Watermark" Value="Ask a question..." />
        </Style>
    </UserControl.Styles>

    <!-- Main Layout -->
    <Grid RowDefinitions="*,Auto,Auto,Auto">

        <!-- Chat Container -->
        <Border
            Grid.Row="0"
            Background="#141414"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="6"
            Margin="8,0,8,8">

            <ScrollViewer
                x:Name="ChatScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="ChatItemsControl" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:ChatMessageModel">
                            <Grid Margin="0,4,0,8">

                                <!-- User Message Bubble (Right Aligned) -->
                                <Border
                                    HorizontalAlignment="Right"
                                    MaxWidth="600"
                                    Background="#2B4C7E"
                                    CornerRadius="12,12,2,12"
                                    Padding="12,8"
                                    IsVisible="{Binding IsUser}">
                                    <SelectableTextBlock
                                        Text="{Binding Content}"
                                        Foreground="White"
                                        FontSize="15"
                                        TextWrapping="Wrap" />
                                </Border>

                                <!-- Assistant Message Bubble (Left Aligned) -->
                                <Border
                                    HorizontalAlignment="Left"
                                    MaxWidth="650"
                                    Background="#222222"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="12,12,12,2"
                                    Padding="12,10"
                                    IsVisible="{Binding !IsUser}">
                                    <SelectableTextBlock
                                        Text="{Binding Content}"
                                        Foreground="#E0E0E0"
                                        FontSize="15"
                                        LineHeight="24"
                                        TextWrapping="Wrap" />
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>
        </Border>

        <!-- Message/Status -->
        <TextBlock
            Grid.Row="1"
            x:Name="MessageTextBlock"
            Classes="messageTextBlock" />

        <!-- Progress Bar -->
        <ProgressBar
            Grid.Row="2"
            x:Name="ProgressBar"
            Height="2"
            Margin="9,0,9,0"
            IsIndeterminate="False" />

        <!-- Input Bar -->
        <Border
            Grid.Row="3"
            Classes="searchBox">

            <Grid ColumnDefinitions="*,Auto,Auto">

                <TextBox
                    Grid.Column="0"
                    x:Name="SendTextBox"
                    Classes="searchTextBox"
                    KeyDown="SendTextBoxOnKeyDown" />

                <Button
                    Grid.Column="1"
                    x:Name="SendButton"
                    Classes="searchButton"
                    Click="SendButtonOnClick"
                    ToolTip.Tip="Send">
                    <avalonia:FluentIcon
                        FontSize="18"
                        Icon="Send" />
                </Button>

                <Button
                    Grid.Column="2"
                    x:Name="CopyButton"
                    Classes="copyButton"
                    Click="CopyButtonOnClick"
                    ToolTip.Tip="Copy last response">
                    <avalonia:FluentIcon
                        FontSize="18"
                        Icon="Copy" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>