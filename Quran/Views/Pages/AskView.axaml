<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:models="clr-namespace:Quran.Models"
    xmlns:helper="clr-namespace:Quran.Helpers.Helper"
    x:Class="Quran.Views.Pages.AskView">

    <UserControl.Styles>

        <!-- Copy & Action Buttons -->
        <Style Selector="Button.copyButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- Ensures content inside aligns to the left edge of the button -->
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.copyButton:pointerover">
            <Setter Property="Background" Value="#333333" />
        </Style>

        <Style Selector="Button.copyButton:pressed">
            <Setter Property="Background" Value="#444444" />
        </Style>

        <Style Selector="Button.searchButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.searchButton:pointerover">
            <Setter Property="Background" Value="#333333" />
        </Style>

        <Style Selector="Button.searchButton:pressed">
            <Setter Property="Background" Value="#444444" />
        </Style>

        <Style Selector="TextBlock.messageTextBlock">
            <Setter Property="Foreground" Value="LightCoral" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Search Container -->
        <Style Selector="Border.searchBox">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <!-- Search TextBox -->
        <Style Selector="TextBox.searchTextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontFamily" Value="avares://Quran/Assets/Fonts/Amiri-Regular.ttf#Amiri" />
            <Setter Property="Watermark" Value="Ask a question..." />
        </Style>

        <Style Selector="TextBlock.timeTextBlock">
            <Setter Property="Foreground" Value="LightGray" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
    </UserControl.Styles>

    <!-- Main Layout -->
    <Grid RowDefinitions="*,Auto,Auto,Auto">

        <!-- Chat Container -->
        <Border
            Grid.Row="0"
            Background="#141414"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="6"
            Margin="8,0,8,0">

            <ScrollViewer
                x:Name="ChatScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="ChatItemsControl" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessageModel">
                            <Grid Margin="0,4,0,8">

                                <!-- User Message Bubble (Right Aligned) -->
                                <Border
                                    HorizontalAlignment="Right"
                                    MaxWidth="600"
                                    MinWidth="300"
                                    BoxShadow="0 2 4 #00000080"
                                    Background="#2B4C7E"
                                    CornerRadius="12,12,2,12"
                                    Padding="12,8"
                                    IsVisible="{Binding IsUser}">
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <SelectableTextBlock
                                            Text="{Binding Content}"
                                            Foreground="#E0E0E0"
                                            FontSize="15"
                                            LineHeight="24"
                                            TextWrapping="Wrap" />

                                        <Grid
                                            Background="#213b62"
                                            HorizontalAlignment="Stretch"
                                            ColumnDefinitions="*,Auto,Auto,Auto">
                                            <!-- User Message Bubble -->
                                            <TextBlock
                                                Classes="timeTextBlock"
                                                Text="{Binding TimeString}" />
                                            <Button
                                                Grid.Column="1"
                                                x:Name="CopyUserButton"
                                                Classes="copyButton"
                                                CommandParameter="{Binding}"
                                                Click="CopyMessageButtonOnClick">
                                                <avalonia:FluentIcon Icon="Copy" FontSize="16" />
                                                <ToolTip.Tip>Copy</ToolTip.Tip>

                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                x:Name="DeleteUserButton"
                                                Classes="copyButton"
                                                CommandParameter="{Binding}"
                                                Click="DeleteMessageButtonOnClick">
                                                <avalonia:FluentIcon Icon="Delete" FontSize="16" />
                                                <ToolTip.Tip>Delete</ToolTip.Tip>

                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Assistant Message Bubble (Left Aligned) -->
                                <Border
                                    HorizontalAlignment="Left"
                                    MaxWidth="650"
                                    MinWidth="300"
                                    BoxShadow="0 2 4 #00000080"
                                    Background="#222222"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    CornerRadius="12,12,12,2"
                                    Padding="12,10"
                                    IsVisible="{Binding !IsUser}">
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <SelectableTextBlock
                                            helper:FormattedTextHelper.FormattedText="{Binding Content}"
                                            Foreground="#E0E0E0"
                                            FontSize="15"
                                            LineHeight="24"
                                            TextWrapping="Wrap" />

                                        <Grid Background="#333333"
                                              HorizontalAlignment="Stretch"
                                              ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                            <TextBlock
                                                Classes="timeTextBlock"
                                                Text="{Binding TimeString}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="timeTextBlock"
                                                       Text="{Binding HumanizedResponseTime}" />
                                            <Button
                                                Grid.Column="3"
                                                x:Name="ShowReferenceButton"
                                                Classes="copyButton"
                                                IsEnabled="{Binding HasReference}"
                                                Click="ShowReferenceButtonOnClick">
                                                <avalonia:FluentIcon Icon="Book" FontSize="16" />
                                                <ToolTip.Tip>Show Reference</ToolTip.Tip>
                                            </Button>
                                            <Button
                                                Grid.Column="4"
                                                x:Name="CopyAiButton"
                                                Classes="copyButton"
                                                CommandParameter="{Binding}"
                                                Click="CopyMessageButtonOnClick">
                                                <avalonia:FluentIcon Icon="Copy" FontSize="16" />
                                                <ToolTip.Tip>Copy</ToolTip.Tip>
                                            </Button>
                                            <Button
                                                Grid.Column="5"
                                                x:Name="DeleteAiButton"
                                                Classes="copyButton"
                                                IsEnabled="{Binding !IsWorking}"
                                                CommandParameter="{Binding}"
                                                Click="DeleteMessageButtonOnClick">
                                                <avalonia:FluentIcon Icon="Delete" FontSize="16" />
                                                <ToolTip.Tip>Delete</ToolTip.Tip>

                                            </Button>

                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>
        </Border>

        <!-- Message/Status -->
        <TextBlock
            Grid.Row="1"
            x:Name="MessageTextBlock"
            Classes="messageTextBlock" />

        <!-- Progress Bar -->
        <ProgressBar x:Name="ProgressBar" Grid.Row="1" IsIndeterminate="False" Height="2" Margin="16,14,16,0" />

        <!-- Input Bar -->
        <Border
            Grid.Row="3"
            Classes="searchBox">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox
                    Grid.Column="0"
                    x:Name="SendTextBox"
                    Classes="searchTextBox"
                    KeyDown="SendTextBoxOnKeyDown" />

                <Button
                    Grid.Column="1"
                    x:Name="SendButton"
                    Classes="searchButton"
                    Click="SendButtonOnClick"
                    ToolTip.Tip="Send">
                    <avalonia:FluentIcon
                        FontSize="18"
                        Icon="Send" />
                </Button>

                <Button
                    Grid.Column="2"
                    x:Name="CopyButton"
                    Classes="copyButton"
                    Click="CopyButtonOnClick"
                    ToolTip.Tip="Copy last response">
                    <avalonia:FluentIcon
                        FontSize="18"
                        Icon="Copy" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>