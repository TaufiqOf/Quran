<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:component="clr-namespace:Quran.Views.Component"
    x:Class="Quran.Views.Pages.HomeView">

    <!-- Styles omitted for brevity -->

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Classes="topBar">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Surahs" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                <component:GotoComponent
                    Grid.Column="1"
                    x:Name="GotoComponent"
                    ShowOnlySurah="True"
                    VerticalAlignment="Center"
                    SurahSelected="GotoComponent_OnSurahSelected" />
            </Grid>
        </Border>

        <!-- Surah Grid -->
        <ScrollViewer
            Grid.Row="1"
            x:Name="ScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsRepeater x:Name="SurahRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout 
                        MinItemHeight="300" 
                        MinItemWidth="350" 
                        Orientation="Horizontal"
                        MinColumnSpacing="8" 
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="component:SurahCardViewModel">
                        <component:CardComponent />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollViewer>
    </Grid>
</UserControl>