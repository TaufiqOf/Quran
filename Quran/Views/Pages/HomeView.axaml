<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quran.Views.Pages.HomeView">

    <Grid 
        HorizontalAlignment="Stretch" 
        VerticalAlignment="Stretch">

        <StackPanel
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"
            Spacing="12">

            <TextBlock
                Text="Home"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Welcome to the Quran application."
                FontSize="16"
                HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</UserControl>