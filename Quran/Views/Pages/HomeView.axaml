<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:component="clr-namespace:Quran.Views.Component"
    x:Class="Quran.Views.Pages.HomeView">

    <UserControl.Styles>
        <!-- =============================== -->
        <!-- Top Bar -->
        <!-- =============================== -->

        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </UserControl.Styles>
    <!-- Styles omitted for brevity -->

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Classes="topBar">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <component:GotoComponent
                    Grid.Column="1"
                    x:Name="GotoComponent"
                    Margin="0,0,5,0"
                    ShowOnlySurah="True"
                    VerticalAlignment="Center"
                    SurahSelected="GotoComponent_OnSurahSelected" />
            </Grid>
        </Border>

        <!-- Surah Grid -->
        <ScrollViewer
            Grid.Row="1"
            x:Name="ScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsRepeater x:Name="SurahRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemHeight="300"
                        MinItemWidth="350"
                        Orientation="Horizontal"
                        MinColumnSpacing="8"
                        ItemsJustification="Center"
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="component:SurahCardViewModel">
                        <component:CardComponent />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </ScrollViewer>
    </Grid>
</UserControl>