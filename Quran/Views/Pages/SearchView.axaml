<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    x:Class="Quran.Views.Pages.SearchView">

    <UserControl.Styles>

        <!-- =============================== -->
        <!-- Copy Button -->
        <!-- =============================== -->

        <Style Selector="Button.copyButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.copyButton:pointerover">
            <Setter Property="Background" Value="#333333" />
        </Style>

        <Style Selector="Button.copyButton:pressed">
            <Setter Property="Background" Value="#444444" />
        </Style>
        <!-- =============================== -->
        <!-- Search Container -->
        <!-- =============================== -->

        <Style Selector="Border.searchBox">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="8" />
        </Style>

        <!-- =============================== -->
        <!-- Search Icon -->
        <!-- =============================== -->

        <Style Selector="avalonia|FluentIcon.searchIcon">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- =============================== -->
        <!-- Search TextBox -->
        <!-- =============================== -->

        <Style Selector="TextBox.searchTextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Watermark" Value="Search Surahs and verses..." />
        </Style>

        <!-- =============================== -->
        <!-- Results -->
        <!-- =============================== -->

        <Style Selector="ItemsControl.searchResults">
            <Setter Property="Margin" Value="8,0,8,8" />
        </Style>

        <Style Selector="ItemsControl.searchResults ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>


    <!-- =============================== -->
    <!-- Main Layout -->
    <!-- =============================== -->

    <Grid RowDefinitions="Auto,*">

        <!-- =========================== -->
        <!-- Search Bar -->
        <!-- =========================== -->

        <Border
            Grid.Row="0"
            Classes="searchBox">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Search Icon -->

                <avalonia:FluentIcon
                    Grid.Column="0"
                    Classes="searchIcon"
                    Icon="Search"
                    VerticalAlignment="Center" />


                <!-- Search Text -->

                <TextBox
                    Grid.Column="1"
                    x:Name="SearchTextBox"
                    Classes="searchTextBox"
                    TextChanged="SearchTextBoxOnTextChanged" />


                <!-- Copy Button -->

                <Button
                    Grid.Column="2"
                    Classes="copyButton"
                    ToolTip.Tip="Copy search results"
                    Click="CopyButton_OnClick">

                    <avalonia:FluentIcon
                        Icon="Copy"
                        FontSize="18" />

                </Button>

            </Grid>

        </Border>


        <!-- =========================== -->
        <!-- Search Results -->
        <!-- =========================== -->

        <ScrollViewer
            Grid.Row="1"
            x:Name="SearchScrollViewer"
            ScrollChanged="LinerScrollViewerOnScrollChanged"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl
                x:Name="SearchItemsControl"
                Classes="searchResults"
                HorizontalAlignment="Stretch">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Styles>

                    <Style Selector="ContentPresenter">
                        <Setter
                            Property="HorizontalContentAlignment"
                            Value="Stretch" />
                    </Style>

                </ItemsControl.Styles>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>