<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Quran.Views.Pages.SettingsView">

    <UserControl.Styles>
        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F2F2F2" />
        </Style>

        <Style Selector="TextBlock.sectionSubtitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#BEBEBE" />
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>

        <Style Selector="ComboBox.settingsInput">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

    </UserControl.Styles>
    <ScrollViewer>
        <Grid Margin="20"
              RowDefinitions="*,Auto,*"
              ColumnDefinitions="*">
            <Border Grid.Row="1"
                    Classes="settingsCard"
                    Width="800"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="sectionTitle"
                               Text="Settings" />

                    <TextBlock Classes="sectionSubtitle"
                               Text="Personalize your reading experience." />

                    <Separator Margin="0,2,0,4" />

                    <TextBlock Classes="fieldLabel"
                               Text="Quran Translation Language" />

                    <ComboBox x:Name="LanguageComboBox"
                              Classes="settingsInput"
                              SelectedIndex="0">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Bangla" Tag="bn" />
                        <ComboBoxItem Content="Spanish" Tag="es" />
                        <ComboBoxItem Content="French" Tag="fr" />
                        <ComboBoxItem Content="Indonesian" Tag="id" />
                        <ComboBoxItem Content="Russian" Tag="ru" />
                        <ComboBoxItem Content="Swedish" Tag="sv" />
                        <ComboBoxItem Content="Turkish" Tag="tr" />
                        <ComboBoxItem Content="Urdu" Tag="ur" />
                        <ComboBoxItem Content="Chinese" Tag="zh" />
                    </ComboBox>

                    <TextBlock Classes="sectionSubtitle"
                               Text="This updates surah translations across the app." />

                    <TextBlock Classes="fieldLabel"
                               Text="Preferred Reader View" />

                    <ComboBox x:Name="ReaderModeComboBox"
                              Classes="settingsInput"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Quranic" Tag="Quranic" />
                        <ComboBoxItem Content="Linear" Tag="Linear" />
                        <ComboBoxItem Content="Compact" Tag="Compact" />
                        <ComboBoxItem Content="Translation" Tag="Translation" />
                    </ComboBox>

                    <TextBlock Classes="sectionSubtitle"
                               Text="Choose your default Quran reading view." />

                    <TextBlock Classes="fieldLabel"
                               Text="Preferred Ai Provider" />

                    <ComboBox x:Name="AiProviderComboBox"
                              Classes="settingsInput"
                              SelectedIndex="0">
                        <ComboBoxItem Content="OpenAI Api" Tag="OpenAI" />
                        <ComboBoxItem Content="Ollama" Tag="Ollama" />
                        <ComboBoxItem Content="LLamaSharp" Tag="LLamaSharp" />
                        <ComboBoxItem Content="Other Models" Tag="CustomLocalApi" />
                    </ComboBox>
                    <TextBlock Classes="fieldLabel"
                               Text="Ai Model" />
                    <TextBox x:Name="AiModelModelTextBox"
                             Classes="settingsInput"
                             PlaceholderText="Enter your AI model here" />

                    <TextBlock Classes="fieldLabel"
                               Text="Ai Api Key/Endpoint" />
                    <TextBox x:Name="AiModelApiKeyTextBox"
                             Classes="settingsInput"
                             PlaceholderText="Enter your AI model API key or Endpoint here" />

                    <Button Classes="primaryAction"
                            Content="Save Preferences"
                            Click="Button_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>